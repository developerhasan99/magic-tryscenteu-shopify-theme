          }
        },
        "review_bjRzPy": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Carolina_Maresca_3.png",
            "content": "<p>„Pachnie bardzo dobrze, oczarował mnie.”</p>",
            "author": "Kamila B.",
            "date": "3 miesiące temu",
            "rating": 5,
            "show_verified_badge": true,
            "product": ""
          }
        },
        "review_YtFw34": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/2026-07-02_16h34_24.png",
            "content": "<p>„Produkt dotarł pięknie zapakowany. Flakon był cały, nic się nie wylało i wszystko było w dobrym stanie. Zapach jest idealny, bez żadnych nieprzyjemnych nut. Uwielbiam go, świetna jakość.”</p>",
            "author": "Roksana S.",
            "date": "5 miesięcy temu",
            "rating": 5,
            "show_verified_badge": true,
            "product": ""
          }
        },
        "review_639hbA": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Ana_Gandarez.jpg",
            "content": "<p>„Przepięknie pachnące perfumy, bardzo trwałe zapachy i doskonała jakość.”</p>",
            "author": "Kamila G.",
            "date": "3 miesiące temu",
            "rating": 5,
            "show_verified_badge": true,
            "product": ""
          }
        },
        "review_G3HzBj": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Celia_Sahki.jpg",
            "content": "<p>„Pachnie dokładnie jak Luna Rossa Carbon, ale kosztuje znacznie mniej. Nie mogę uwierzyć, jak bardzo jest podobny.”</p>",
