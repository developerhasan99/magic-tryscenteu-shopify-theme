          "settings": {
            "review_image": "shopify://shop_images/Anastasiia_Komisarova.jpg",
            "content": "<p>„Idealny i przepiękny 🥰🥰🥰”</p>",
            "author": "Lidia A.",
            "date": "2 miesiące temu",
            "rating": 5,
