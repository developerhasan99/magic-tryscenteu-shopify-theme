        "review_Vb9HW7": {
          "type": "review",
          "settings": {
            "content": "<p>„Bardzo dobra marka, uwielbiam opakowanie i zapach.”</p>",
            "author": "Roża B",
            "date": "7 miesięcy temu",
            "rating": 5,
