        "review_JRzxRP": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/345.png",
            "content": "<p>\"Ich bin zufrieden mit Tryscent. Der Duft riecht dem Original sehr ähnlich und hält gut. Die Verpackung ist ordentlich und die Flasche sieht schön aus. Insgesamt ist es eine großartige Option, wenn man einen Qualitätsduft zu einem vernünftigen Preis möchte.\"</p>",
