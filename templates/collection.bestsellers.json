om .ts-hero-inner{\n    min-height:auto;\n    display:block;\n    padding-top:40px;\n    padding-bottom:380px;\n  }\n  #ts-hero-custom .ts-hero-copy{\n    max-width:100%;\n    text-align:center;\n  }\n  #ts-hero-custom .ts-rating-pill{margin-bottom:22px}\n  #ts-hero-custom h1{\n    font-size:30px;\n    margin-bottom:18px;\n  }\n  #ts-hero-custom .ts-category-line,\n  #ts-hero-custom .ts-expert-line{\n    margin-inline:auto;\n  }\n  #ts-hero-custom .ts-microcopy{\n    color:rgba(18,18,18,.8);\n    font-weight:600;\n  }\n}\n</style>\n<section id=\"ts-hero-custom\">\n  <div class=\"ts-container\">\n    <div class=\"ts-hero-inner\">\n      <div class=\"ts-hero-copy\">\n        <div class=\"ts-rating-pill\">\n          <span class=\"ts-stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</span>\n          <span>Von über 10.000 Kunden geliebt</span>\n        </div>\n        <h1>Finde den Duft, der dafür sorgt, dass sie immer an dich denken.</h1>\n        <div class=\"ts-category-line\">Die erste Wahl bei von Designern inspirierten Parfums.</div>\n        <p class=\"ts-expert-line\">Hergestellt von denselben Parfümeuren, die hinter einigen der bekanntesten Düfte der Welt stehen.</p>\n        <p class=\"ts-microcopy\">Glaub uns nicht einfach. Überzeug dich selbst.</p>\n      </div>\n    </div>\n  </div>\n</section>",
