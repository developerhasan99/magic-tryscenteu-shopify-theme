<style>
  .mgx-collection-hero-overlay {
    background: linear-gradient(180deg, rgba(var(--mgx-white-rgb), 0) 38%, rgba(var(--mgx-white-rgb), 0.82) 58%, rgba(var(--mgx-white-rgb), 0.97) 74%, var(--mgx-white) 100%);
  }
  @media (min-width: 640px) {
    .mgx-collection-hero-overlay {
      background: linear-gradient(90deg, rgba(var(--mgx-white-rgb), 0.97) 0%, rgba(var(--mgx-white-rgb), 0.93) 30%, rgba(var(--mgx-white-rgb), 0.72) 46%, rgba(var(--mgx-white-rgb), 0) 68%);
    }
  }
</style>
{%- assign hero_mobile_image = collection.metafields.custom.hero_mobile_image -%}
{%- assign hero_desktop_image = collection.image -%}
<div class="relative flex h-auto min-h-[520px] items-end mgx-surface bg-[image:var(--hero-img-mobile)] bg-cover bg-[position:50%_10%] bg-no-repeat pb-[34px] sm:h-[clamp(430px,33.33vw,600px)] sm:min-h-0 sm:items-center sm:bg-[image:var(--hero-img-desktop)] sm:bg-[position:50%_3%] sm:pb-0" style="{% if hero_mobile_image %}--hero-img-mobile: url('{{ hero_mobile_image | image_url: width: 750 }}');{% endif %} {% if hero_desktop_image %}--hero-img-desktop: url('{{ hero_desktop_image | image_url: width: 1920 }}');{% endif %}">
  <div class="!block absolute inset-0 mgx-collection-hero-overlay"></div>
  <div class="page-width relative z-[1] w-full">
    <div class="md:w-1/2 {% if hero_mobile_image != blank %} pt-80 md:pt-0 {% endif %}">
      {% if section.settings.show_rating_badge %}
        <p class="mb-[10px] flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.16em] mgx-text-accent">
          <span class="tracking-[0.06em]">★★★★★</span>
          {{ section.settings.rating_text }}
        </p>
      {% endif %}
      <h1 class="mb-3 whitespace-nowrap text-[clamp(28px,2.8vw,44px)] font-normal leading-[1.1] tracking-[-0.015em] mgx-text" style="font-family: Georgia, 'Times New Roman', serif;">
        {% if section.settings.heading != blank %}
          {{ section.settings.heading }}
        {% else %}
          {% render 'polish-store-text', text: collection.title %}
        {% endif %}
      </h1>
      <p class="max-w-[400px] text-[clamp(15px,1.05vw,17px)] leading-[1.5] mgx-text">
        {{ collection.description }}
      </p>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Collection Hero",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading (empty = collection title)",
        "default": "Najnowsze zapachy 🔥"
      },
      {
        "type": "checkbox",
        "id": "show_rating_badge",
        "label": "Show rating badge",
        "default": true
      },
      {
        "type": "text",
        "id": "rating_text",
        "label": "Rating badge text",
        "default": "Sprawdzone przez ponad 10 000 miłośników zapachów"
      }
    ],
    "presets": [
      {
        "name": "Collection Hero"
      }
    ]
  }
{% endschema %}