{% doc %}
  Scent picker modal for sections/mgx-bundle-offer.liquid. Page-safe: no `product` object.
  Must be rendered INSIDE the section's x-data="mgxBundleOffer(...)" root; the dialog is teleported
  to <body> and keeps that Alpine scope (picks, filtered, add, removeOne, closePicker, ...).
  @param {string} section_id - Section id, used for unique element ids.
  @param {string} [heading] - Dialog title.
{% enddoc %}
<template x-teleport="body">
  <div
    class="mgx-bo mgx-bo-modal mgx-text"
    x-show="open"
    x-cloak
    x-transition.opacity.duration.200ms
    @keydown.escape.window="closePicker()">
    <div class="mgx-bo-modal__overlay" @click="closePicker()"></div>
    <div
      class="mgx-bo-modal__panel mgx-surface"
      role="dialog"
      aria-modal="true"
      aria-labelledby="MgxBoPickerTitle-{{ section_id }}">
      <div class="mgx-bo-modal__head">
        <div class="mgx-bo-modal__title-row">
          <h2 class="mgx-bo-modal__title" id="MgxBoPickerTitle-{{ section_id }}">
            {{- heading | default: 'Wybierz zapachy' -}}
          </h2>
          <button type="button" class="mgx-bo-modal__close mgx-close" @click="closePicker()" aria-label="Zamknij">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </div>
        <p class="mgx-bo-modal__count" aria-live="polite">
          Wybrano <strong x-text="picks.length + '/' + size"></strong>
          <span x-show="remaining > 0" x-text="', zostało ' + remaining"></span>
        </p>
        <label class="mgx-bo-modal__search">
          <span class="mgx-bo-visually-hidden">Szukaj zapachu</span>
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><path d="M8.5 3a5.5 5.5 0 014.4 8.8l3.7 3.7-1.4 1.4-3.7-3.7A5.5 5.5 0 118.5 3zm0 2a3.5 3.5 0 100 7 3.5 3.5 0 000-7z" fill="currentColor"/></svg>
          <input
            type="search"
            x-ref="search"
            x-model.debounce.150ms="q"
            placeholder="Szukaj po nazwie lub inspiracji"
            autocomplete="off">
        </label>
        <div class="mgx-bo-modal__filters" role="group" aria-label="Filtr">
          <button type="button" class="mgx-bo-modal__pill" :class="filter === 'all' ? 'mgx-pill-active' : 'mgx-pill'" :aria-pressed="filter === 'all' ? 'true' : 'false'" @click="filter = 'all'">Wszystkie</button>
          <button type="button" class="mgx-bo-modal__pill" :class="filter === 'f' ? 'mgx-pill-active' : 'mgx-pill'" :aria-pressed="filter === 'f' ? 'true' : 'false'" @click="filter = 'f'">Dla niej</button>
          <button type="button" class="mgx-bo-modal__pill" :class="filter === 'm' ? 'mgx-pill-active' : 'mgx-pill'" :aria-pressed="filter === 'm' ? 'true' : 'false'" @click="filter = 'm'">Dla niego</button>
        </div>
      </div>

      <div class="mgx-bo-modal__body">
        <ul class="mgx-bo-modal__grid" role="list">
          <template x-for="p in filtered" :key="p.variantId">
            <li class="mgx-bo-modal__card" :class="{ 'is-picked': countOf(p) > 0 }">
              <div class="mgx-bo-modal__media">
                <img x-show="p.image" :src="p.image" :alt="p.title" width="300" height="300" loading="lazy">
                <span class="mgx-bo-modal__qty mgx-badge-amber" x-show="countOf(p) > 0" x-text="'×' + countOf(p)"></span>
              </div>
              <span class="mgx-bo-modal__name" x-text="p.title"></span>
              <span class="mgx-bo-modal__insp" x-show="p.inspiration" x-text="'Inspiracja: ' + p.inspiration"></span>
              <span class="mgx-bo-modal__price" x-text="money(p.price)"></span>
              <div class="mgx-bo-modal__actions">
                <button
                  type="button"
                  class="mgx-bo-modal__minus"
                  x-show="countOf(p) > 0"
                  @click="removeOne(p)"
                  :aria-label="'Usuń jeden: ' + p.title">−</button>
                <button
                  type="button"
                  class="mgx-bo-modal__add mgx-btn-primary"
                  :disabled="remaining === 0"
                  @click="add(p)"
                  :aria-label="'Dodaj ' + p.title">Dodaj</button>
              </div>
            </li>
          </template>
        </ul>
        <p class="mgx-bo-modal__none" x-show="filtered.length === 0">Brak zapachów pasujących do wyszukiwania.</p>
      </div>

      <div class="mgx-bo-modal__foot">
        <button type="button" class="mgx-bo-modal__done mgx-btn-primary" @click="closePicker()">Gotowe</button>
      </div>
    </div>
  </div>
</template>
