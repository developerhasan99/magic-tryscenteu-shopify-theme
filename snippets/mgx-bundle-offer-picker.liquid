{% doc %}
  Scent picker modal for sections/mgx-bundle-offer.liquid. Page-safe: no `product` object.
  Mirrors the row list of snippets/custom-offer-bundle-modal.liquid (thumb, name, badge,
  inspiration, +/check circle; tap a row to toggle it).
  Must be rendered INSIDE the section's x-data="mgxBundleOffer(...)" root; the dialog is teleported
  to <body> and keeps that Alpine scope (picks, filtered, toggle, countOf, closePicker, ...).
  @param {string} section_id - Section id, used for unique element ids.
  @param {string} ml_label - Bottle size label shown on each row, e.g. "50 ml".
{% enddoc %}
<template x-teleport="body">
  <div
    class="mgx-bo mgx-bo-modal mgx-text"
    x-show="open"
    x-cloak
    x-transition.opacity.duration.200ms
    @keydown.escape.window="closePicker()">
    <div class="mgx-bo-modal__overlay" @click="closePicker()"></div>
    <div
      class="mgx-bo-modal__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="MgxBoPickerTitle-{{ section_id }}">
      <button type="button" class="mgx-bo-modal__close mgx-surface mgx-close" @click="closePicker()" aria-label="Zamknij">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>

      <div class="mgx-bo-modal__head">
        <div class="mgx-bo-modal__intro mgx-border">
          <h2 class="mgx-bo-modal__title" id="MgxBoPickerTitle-{{ section_id }}" aria-live="polite">
            <span x-show="remaining === 0">Twój zestaw jest gotowy!</span>
            <span x-show="remaining > 0" x-text="'Wybierz jeszcze: ' + remaining + ' ' + word(remaining)"></span>
          </h2>
          <p class="mgx-bo-modal__sub mgx-text-muted">
            Liczba flakonów w Twoim zestawie: <span x-text="size"></span>
          </p>
        </div>
        <div class="mgx-bo-modal__filters" role="group" aria-label="Filtr">
          <button type="button" class="mgx-bo-modal__pill" :class="filter === 'all' ? 'mgx-pill-active' : 'mgx-pill'" :aria-pressed="filter === 'all' ? 'true' : 'false'" @click="filter = 'all'">Bestsellery</button>
          <button type="button" class="mgx-bo-modal__pill" :class="filter === 'm' ? 'mgx-pill-active' : 'mgx-pill'" :aria-pressed="filter === 'm' ? 'true' : 'false'" @click="filter = 'm'">Dla mężczyzn</button>
          <button type="button" class="mgx-bo-modal__pill" :class="filter === 'f' ? 'mgx-pill-active' : 'mgx-pill'" :aria-pressed="filter === 'f' ? 'true' : 'false'" @click="filter = 'f'">Dla kobiet</button>
        </div>
        <label class="mgx-bo-modal__search mgx-border">
          <span class="mgx-bo-visually-hidden">Szukaj zapachu</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
          <input
            type="search"
            x-ref="search"
            x-model.debounce.150ms="q"
            placeholder="Szukaj..."
            autocomplete="off">
        </label>
      </div>

      <div class="mgx-bo-modal__body">
        <ul class="mgx-bo-modal__list" role="list">
          <template x-for="p in filtered" :key="p.variantId">
            <li>
              <button
                type="button"
                class="mgx-bo-modal__row"
                :class="countOf(p) > 0 ? 'mgx-selected' : 'mgx-border'"
                :aria-pressed="countOf(p) > 0 ? 'true' : 'false'"
                :disabled="countOf(p) === 0 && remaining === 0"
                @click="toggle(p)">
                <img class="mgx-bo-modal__thumb" x-show="p.image" :src="p.image" :alt="p.title" width="56" height="56" loading="lazy">
                <span class="mgx-bo-modal__info">
                  <span class="mgx-bo-modal__name-row">
                    <span class="mgx-bo-modal__name" x-text="p.title"></span>
                    <span class="mgx-bo-modal__badge mgx-badge-amber" x-show="p.tags.indexOf('bestseller') > -1">Bestseller</span>
                  </span>
                  <span class="mgx-bo-modal__insp mgx-text-muted" x-show="p.inspiration">
                    Inspiracja: <strong x-text="p.inspiration"></strong>
                  </span>
                </span>
                <span class="mgx-bo-modal__side">
                  <span class="mgx-bo-modal__ml mgx-text-muted">{{ ml_label }}</span>
                  <span class="mgx-bo-modal__check mgx-check" :class="{ 'mgx-check--on': countOf(p) > 0 }" aria-hidden="true">
                    <span x-show="countOf(p) === 0">+</span>
                    <svg x-show="countOf(p) > 0" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
                  </span>
                </span>
              </button>
            </li>
          </template>
        </ul>
        <p class="mgx-bo-modal__none" x-show="filtered.length === 0">Brak zapachów pasujących do wyszukiwania.</p>
      </div>
    </div>
  </div>
</template>
