{% if product == blank %}
  {% assign product = product_param %}
{% endif %}

{% liquid
  # Products tagged 'own_gallery' show only their own images, no marketing images
  unless product.tags contains 'own_gallery'
    assign marketing_images = shop.metaobjects['marketing_images']['for-de'].images.value
    assign pl_marketing_images = shop.metaobjects['marketing_images']['for-pl'].images.value
    assign irish_en_marketing_images = shop.metaobjects['marketing_images']['for-irish-en'].images.value
    assign french_marketing_images = shop.metaobjects['marketing_images']['for-french'].images.value
    assign czech_marketing_images = shop.metaobjects['marketing_images']['for-czech'].images.value
  endunless

  # Bundle graphic for this visitor: bundle_<storefront country>, then bundle_pl, then the first image.
  # Root-domain markets (incl. the DE fallback) count as Poland, see snippets/storefront-country.
  assign wanted_alt = ''
  if product.tags contains 'local_image'
    capture wanted_alt
      render 'bundle-image-alt', product: product
    endcapture
    assign wanted_alt = wanted_alt | strip
  endif
%}

<div class="sticky top-6">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <script defer src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <div class="flex -mx-[15px] md:mx-0">
    <div id="productSwiper" class="swiper">
      <div class="swiper-wrapper">
        {% if product.tags contains "local_image" %}
          {% assign image_found = false %}
          {% for image in product.images %}
            {% assign img_alt = image.alt | downcase %}
            {% if wanted_alt != blank and img_alt == wanted_alt %}
              {% assign image_found = true %}
              <img
                src="{{ image.src | img_url: 'master' }}"
                alt="{{ image.alt }}"
                height="{{ image.height }}"
                width="{{ image.width }}"
                class="productSwiperImage swiper-slide md:rounded-lg">
            {% endif %}
          {% endfor %}
          {% if image_found == false %}
            {% for image in product.images limit: 1 %}
                <img
                  src="{{ image.src | img_url: 'master' }}"
                  alt="{{ image.alt }}"
                  height="{{ image.height }}"
                  width="{{ image.width }}"
                  class="productSwiperImage swiper-slide md:rounded-lg">
            {% endfor %}
          {% endif %}
          {% if marketing_images != blank %}
            {% for image in marketing_images %}
              <img
                src="{{ image.src | image_url: width: 450 }}"
                alt="{{ image.alt }}"
                height="{{ image.height }}"
                width="{{ image.width }}"
                class="productSwiperImage swiper-slide md:rounded-lg marketing_image">
            {% endfor %}
          {% endif %}
        {% else %}
          {% for image in product.images limit: 1 %}
            <img
              src="{{ image.src | img_url: 'master' }}"
              alt="{{ image.alt }}"
              height="{{ image.height }}"
              width="{{ image.width }}"
              class="productSwiperImage swiper-slide md:rounded-lg">
          {% endfor %}
          {% if marketing_images != blank %}
            {% for image in marketing_images %}
              <img
                src="{{ image.src | img_url: 'master' }}"
                alt="{{ image.alt }}"
                height="{{ image.height }}"
                width="{{ image.width }}"
                class="productSwiperImage swiper-slide md:rounded-lg marketing_image">
            {% endfor %}
          {% endif %}
        {% endif %}
      </div>
      <div
        data-text="text"
        id="productSwiperPrev"
        class="swiper-button-prev rounded-full !flex bg-white !size-10 [&]:after:!text-xl [&]:after:text-gray-900"></div>
      <div
        data-text="text"
        id="productSwiperNext"
        class="swiper-button-next rounded-full !flex bg-white !size-10 [&]:after:!text-xl [&]:after:text-gray-900"></div>
    </div>
  </div>
  <div>
    <div id="productThumbnails" class="swiper mt-4">
      <div class="swiper-wrapper [&>.swiper-slide-thumb-active]:border-black [&>.swiper-slide-thumb-active]:opacity-100">
        {% if product.tags contains "local_image" %}
          {% assign image_found = false %}
          {% for image in product.images %}
            {% assign img_alt = image.alt | downcase %}
            {% if wanted_alt != blank and img_alt == wanted_alt %}
              {% assign image_found = true %}
              <img
                id="slider-thumbnail-{{ forloop.index0 }}"
                src="{{ image | image_url: width: 150, height: 150 }}"
                alt="{{ image.alt }}"
                height="150"
                width="150"
                class="productThumbnail swiper-slide slide max-w-16 md:max-w-24 opacity-70 border-2 border-solid mgx-border rounded-lg cursor-pointer" />
            {% endif %}
          {% endfor %}
          {% if image_found == false %}
            {% for image in product.images limit: 1 %}
                <img
                  id="slider-thumbnail-{{ forloop.index0 }}"
                  src="{{ image | image_url: width: 150, height: 150 }}"
                  alt="{{ image.alt }}"
                  height="150"
                  width="150"
                  class="productThumbnail swiper-slide slide max-w-16 md:max-w-24 opacity-70 border-2 border-solid mgx-border rounded-lg cursor-pointer" />
            {% endfor %}
          {% endif %}
          {% if marketing_images != blank %}
            {% for image in marketing_images %}
              <img
                id="slider-thumbnail-{{ forloop.index0 }}"
                src="{{ image | image_url: width: 150, height: 150 }}"
                alt="{{ image.alt }}"
                height="150"
                width="150"
                class="productThumbnail swiper-slide slide max-w-16 md:max-w-24 opacity-70 border-2 border-solid mgx-border rounded-lg cursor-pointer marketing_image" />
            {% endfor %}
          {% endif %}
        {% else %}
          {% for image in product.images limit: 1 %}
            <img
              id="slider-thumbnail-{{ forloop.index0 }}"
              src="{{ image | image_url: width: 150, height: 150 }}"
              alt="{{ image.alt }}"
              height="150"
              width="150"
              class="productThumbnail swiper-slide slide max-w-16 md:max-w-24 opacity-70 border-2 border-solid mgx-border rounded-lg cursor-pointer" />
          {% endfor %}
          {% if marketing_images != blank %}
            {% for image in marketing_images %}
              <img
                id="slider-thumbnail-{{ forloop.index0 }}"
                src="{{ image | image_url: width: 150, height: 150 }}"
                alt="{{ image.alt }}"
                height="150"
                width="150"
                class="productThumbnail swiper-slide slide max-w-16 md:max-w-24 opacity-70 border-2 border-solid mgx-border rounded-lg cursor-pointer marketing_image" />
            {% endfor %}
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>

  <script>
      {% if marketing_images != blank %}
      // Local images to load for Weglot languages
      const localImages = {
        de: {
          main: [
            {% for item in marketing_images %}
              "{{ item | image_url: width: 1024, height: 1024 }}"{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ],
          thumbnail: [
            {% for item in marketing_images %}
              "{{ item | image_url: width: 300, height: 300 }}"{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        },
        pl: {
          main: [
            {% for item in pl_marketing_images %}
              "{{ item | image_url: width: 1024, height: 1024 }}"{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ],
          thumbnail: [
            {% for item in pl_marketing_images %}
              "{{ item | image_url: width: 300, height: 300 }}"{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        },
        en: {
          main: [
            {% for item in irish_en_marketing_images %}
              "{{ item | image_url: width: 1024, height: 1024 }}"{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ],
          thumbnail: [
            {% for item in irish_en_marketing_images %}
              "{{ item | image_url: width: 300, height: 300 }}"{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        },
        fr: {
          main: [
            {% for item in french_marketing_images %}
              "{{ item | image_url: width: 1024, height: 1024 }}"{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ],
          thumbnail: [
            {% for item in french_marketing_images %}
              "{{ item | image_url: width: 300, height: 300 }}"{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        },
        cs: {
          main: [
            {% for item in czech_marketing_images %}
              "{{ item | image_url: width: 1024, height: 1024 }}"{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ],
          thumbnail: [
            {% for item in czech_marketing_images %}
              "{{ item | image_url: width: 300, height: 300 }}"{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        }
      };
      {% endif %}
      // Swiper Slider For product images with thumbnail sync
      window.addEventListener("DOMContentLoaded", function () {
        var productThumbnails = new Swiper('#productThumbnails', {
          slidesPerView: 5,
          spaceBetween: 8,
          freeMode: true,
          watchSlidesProgress: true,
          watchOverflow: true,
          direction: 'horizontal',
          slideToClickedSlide: true,
          breakpoints: {
            320: {
              slidesPerView: 4,
            },
            600: {
              slidesPerView: 4,
            },
            900: {
              slidesPerView: 5,
            }
          }
        });

        var productImages = new Swiper('#productSwiper', {
          slidesPerView: 1,
          spaceBetween: 10,
          observer: true,
          observeParents: true,
          navigation: {
            prevEl: "#productSwiperPrev",
            nextEl: "#productSwiperNext",
          },
          thumbs: {
            swiper: productThumbnails
          },
          breakpoints: {
            320: {
              slidesPerView: 1,
              spaceBetween: 10,
            },
            600: {
              slidesPerView: 1,
              spaceBetween: 20,
            },
            800: {
              slidesPerView: 1,
              spaceBetween: 20,
            },
          },
        });

        {% if marketing_images != blank %}
        function changeLocalImages(newLang, _previousLang) {
          console.log('Language Changed: ', newLang);
      
          const marketingMainImages = Array.from(document.querySelectorAll('#productSwiper .marketing_image'));
          const marketingThumbnailImages = Array.from(document.querySelectorAll('#productThumbnails .marketing_image'));

          if (localImages[newLang]) {
            const localizedImages = localImages[newLang];
            const hasMatchingMainCount = localizedImages.main.length === marketingMainImages.length;
            const hasMatchingThumbnailCount = localizedImages.thumbnail.length === marketingThumbnailImages.length;

            if (hasMatchingMainCount && hasMatchingThumbnailCount) {
              marketingMainImages.forEach((image, index) => {
                image.src = localizedImages.main[index];
              });

              marketingThumbnailImages.forEach((image, index) => {
                image.src = localizedImages.thumbnail[index];
              });
            }

            // updated the scent breakdown section image also
            const breakdownImageEl = document.getElementById('scent-breakdown-img');
            if(typeof breakdownImageEl != "undefined"){
              breakdownImageEl.src = localizedImages.main[0];
            }
          } else {
            marketingMainImages.forEach((image) => image.remove());
            marketingThumbnailImages.forEach((image) => image.remove());
          }
        }

        const currentLang = (window.Weglot && typeof Weglot.getCurrentLang === 'function' && Weglot.getCurrentLang()) || 'de';
        changeLocalImages(currentLang, null);
        Weglot.on("languageChanged", changeLocalImages);
        {% endif %}
      });

  </script>
</div>