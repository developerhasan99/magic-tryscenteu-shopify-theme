{%- comment -%}
  Badges under the add-to-cart. Rendered by reactive-atc and quantity-breaker.
  One row of equal tiles: 48h delivery in Poland, InPost, 60-day guarantee.
{%- endcomment -%}
<style>
  .shipping-badges { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); }
  .shipping-badges__item { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 4px 6px; text-align: center; }
  .shipping-badges__item + .shipping-badges__item { border-left: 1px solid var(--mgx-hairline); }
  .shipping-badges__icon { display: block; width: 28px; height: 28px; }
  .shipping-badges__icon svg { display: block; width: 100%; height: 100%; fill: currentColor; }
  .shipping-badges__logo { display: block; height: 28px; width: auto; }
  .shipping-badges__text { font-size: 12px; line-height: 1.3; font-weight: 600; }
  .shipping-badges__note { margin: 8px 0 0; font-size: 12px; line-height: 1.4; text-align: center; }
  @media (min-width: 750px) {
    .shipping-badges__item { padding: 4px 10px; }
    .shipping-badges__text { font-size: 13px; }
  }
</style>
<div class="shipping-badges mt-6 mgx-text">
  <div class="shipping-badges__item">
    <span class="shipping-badges__icon" aria-hidden="true">{{ 'icon-truck.svg' | inline_asset_content }}</span>
    <span class="shipping-badges__text">Dostawa w 48 godzin na terenie Polski</span>
  </div>
  <div class="shipping-badges__item">
    <img
      class="shipping-badges__logo [filter:grayscale(1)]"
      src="{{ 'inpost-logo.svg' | asset_url }}"
      alt="InPost"
      width="47"
      height="28"
      loading="lazy">
    <span class="shipping-badges__text">Bezpieczna wysyłka z InPost</span>
  </div>
  <div class="shipping-badges__item">
    <img
      class="shipping-badges__logo [filter:grayscale(1)]"
      src="{{ 'guarantee-badge.png' | asset_url }}"
      alt=""
      width="28"
      height="28"
      loading="lazy">
    <span class="shipping-badges__text">Wypróbuj przez 60 dni, bez ryzyka.</span>
  </div>
</div>
<p class="shipping-badges__note mgx-text-muted mb-6 [display:none] md:block">Jeśli produkt nie spełni Twoich oczekiwań, zwrócimy Ci pełną kwotę!</p>
